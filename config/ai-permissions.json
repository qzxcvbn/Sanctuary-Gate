{
  "policy_metadata": {
    "version": "1.3.0",
    "legal_framework": "Apache License 2.0"
  },
  "ingestion_governance": {
    "global_default": "CHALLENGE",
    "enforced_handshake": true,
    "monetization_enabled": false,
    "public_directories": ["/"],
    "blocked_user_agents": [
      "GPTBot",
      "CCBot",
      "Bytespider",
      "Google-Extended",
      "PerplexityBot",
      "Amazonbot",
      "ImagesiftBot",
      "Diffbot",
      "Meta-ExternalAgent"
    ],
    "known_hosting_cidrs": [
      "3.0.0.0/8",
      "13.0.0.0/8",
      "34.0.0.0/8",
      "35.0.0.0/8",
      "52.0.0.0/8"
    ],
    "rate_limit": {
      "requests_per_minute": 60,
      "burst": 20
    },
    "pow_challenge": {
      "enabled": true,
      "difficulty_bits": 18,
      "hosting_difficulty_bonus": 4,
      "challenge_ttl_seconds": 60,
      "session_ttl_seconds": 900
    },
    "route_overrides": [],
    "authorized_aggregators": {
      "Google-Gemini-Bot": {
        "access_status": "ALLOWED_PAID",
        "mint_public_key": "REPLACE_WITH_YOUR_ED25519_PUBLIC_KEY_HEX",
        "permitted_directories": ["/public/open-access/"],
        "monetization_handshake_url": "http://mint:8081/v1/mint"
      }
    }
  }
}
